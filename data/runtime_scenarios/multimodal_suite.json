[
  {
    "name": "audio_flight_pivot",
    "theme": "multimodal_interruption",
    "description": "In-car analogue: destination changes while the search runs; the stale search is cancelled, the morning constraint survives.",
    "manifests": [
      "builtin"
    ],
    "events": [
      {
        "at_ms": 10,
        "type": "audio",
        "text": "Find flights to Delhi tomorrow morning",
        "confidence": 0.92
      },
      {
        "at_ms": 300,
        "type": "interrupt"
      },
      {
        "at_ms": 320,
        "type": "audio",
        "text": "Actually, Bangalore",
        "confidence": 0.92
      }
    ],
    "run_ms": 3000,
    "expect": {
      "completed": [
        {
          "tool": "search_flights",
          "args": {
            "to": "Bangalore",
            "date": "2026-09-26",
            "slot": "morning"
          }
        }
      ],
      "cancelled": [
        {
          "tool": "search_flights",
          "args": {
            "to": "Delhi"
          }
        }
      ],
      "final_slots": {
        "to": "Bangalore",
        "slot": "morning",
        "date": "2026-09-26"
      }
    }
  },
  {
