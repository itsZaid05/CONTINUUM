{
  "name": "timeout_booking",
  "description": "Timeout on IRREVERSIBLE book: must verify before retry, not blind retry (no double-book).",
  "initial_state": { "destination": "Bangalore", "dates": "next Monday", "goal_domain": "flights" },
  "turns": [
    { "at_ms": 0, "user": "Book Bangalore flights for next Monday" },
    { "at_ms": 50, "tool_start": "search:Bangalore" },
    { "at_ms": 300, "tool_result": { "id": "search:1:0", "payload": { "flights": ["AI-201"] }, "based_on": 1 } },
    { "at_ms": 350, "tool_start": "book" },
    { "at_ms": 600, "inject_timeout": "book" }
  ]
}
