# ==============================================================================
# CONTINUUM Environment Configuration (Example Template)
# PRISM Generative AI Hackathon (Theme 05: Interruptible Real-Time Agents)
# ==============================================================================

# 1. Google Gemini API Key (for LLM reasoning & open-domain Q&A)
# Get a free key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here
GOOGLE_API_KEY=your_gemini_api_key_here

# 2. LiveKit Cloud Credentials (for FDB-v3 voice agent benchmark harness)
# Get free credentials at: https://cloud.livekit.io (Settings > Keys)
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=your_livekit_api_key_here
LIVEKIT_API_SECRET=your_livekit_api_secret_here

# 3. CONTINUUM Engine Execution Settings
CONTINUUM_BACKEND=offline-fake
CONTINUUM_TEMPERATURE=1.2
FASTAPI_HOST=0.0.0.0
FASTAPI_PORT=8000
